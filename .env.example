# Read only by api/extract.ts on the server. NEVER prefix this VITE_ —
# anything VITE_-prefixed is inlined into the client bundle and is public.
# Get one at https://aistudio.google.com/apikey (no GCP project, no card).
GEMINI_API_KEY=

# Injected automatically by the Vercel Upstash integration.
# Pull them locally with: vercel env pull .env.local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
